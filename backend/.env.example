# ==============================================================================
# QuickBite Backend — Environment Template (.env.example)
# ==============================================================================
# HOW THIS FILE WORKS:
# 1. Copy this file to "backend/.env" before running the backend.
# 2. You can keep ALL variables (Supabase, Local DB, Proxy, etc.) defined here simultaneously.
# 3. The switches (SPRING_PROFILES_ACTIVE and DB_TARGET) decide which ones are actively used.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME PROFILE
# ------------------------------------------------------------------------------
PORT=8080

# Profile Selection:
# - Set to "dev"  -> Activates application-dev.yml (Prints SQL queries, enables DEBUG logs & Swagger)
# - Set to "prod" -> Activates application-prod.yml (Silent production mode, hides stacktraces)
SPRING_PROFILES_ACTIVE=dev

# Allowed frontend origins for CORS (React browser dev server & Electron desktop shell)
CORS_ALLOWED_ORIGIN_PATTERNS=*

# Secret key required for instant Administrator self-verification and suspension actions
ADMIN_SIGNUP_KEY=your_admin_security_key

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION & TARGET SELECTION
# ------------------------------------------------------------------------------
# Choose which database to activate: "supabase" OR "local" (NO silent fallback)
# - If "supabase": Spring Boot uses SUPABASE_DB_* below.
# - If "local":    Spring Boot uses LOCAL_DB_* below.
DB_TARGET=supabase

SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_FLYWAY_ENABLED=true

# --- TARGET A: Supabase Cloud PostgreSQL (Active when DB_TARGET=supabase) ---
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<supabase-project-ref>
SUPABASE_DB_PASSWORD=your_supabase_db_password

# --- TARGET B: Local PostgreSQL (Active when DB_TARGET=local) ---
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/quickbite
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=your_local_postgres_password

# ------------------------------------------------------------------------------
# 3. FIREBASE AUTHENTICATION (ADMIN SDK)
# ------------------------------------------------------------------------------
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=quick-bite-firebase

# Credentials:
# - Local dev: path to json file (e.g. FIREBASE_CONFIG_PATH=firebase-adminsdk.json)
# - Cloud/Render: paste raw or base64 JSON string into FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_CONFIG_PATH=firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 4. SUPABASE STORAGE (MEDIA & PHOTO HOSTING)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<supabase-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=QuickBite

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (RAZORPAY TEST MODE)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# ------------------------------------------------------------------------------
# 6. NETWORK & PROXY CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# - On Home Wi-Fi / Mobile Hotspot / Cloud Render: Keep PROXY_ENABLED=false
# - On Restricted Campus / Corporate Intranets: Set PROXY_ENABLED=true
PROXY_ENABLED=false
PROXY_HOST=172.31.2.4
PROXY_PORT=8080
PROXY_NON_PROXY_HOSTS=localhost|127.0.0.1
PREFER_IPV4_STACK=true
