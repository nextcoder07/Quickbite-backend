# ==============================================================================
# QuickBite Frontend — Environment Template (.env.example)
# ==============================================================================
# HOW THIS FILE WORKS:
# 1. Copy this file to "frontend/.env" (or .env.development / .env.production).
# 2. Vite exposes any variable prefixed with "VITE_" via import.meta.env.
# 3. Running "npm run dev" uses development settings; "npm run dist" uses production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API TARGET
# ------------------------------------------------------------------------------
# Local Spring Boot Backend:
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Or Render Cloud Backend:
# VITE_API_BASE_URL=https://<your-render-app>.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (RAZORPAY TEST KEY)
# ------------------------------------------------------------------------------
# VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
