# ==============================================================================
# QuickBite Campus Food Marketplace - Environment Configuration Template
# Copy this file to .env or configure respective frontend/backend environments.
# NEVER commit real credentials to source control.
# ==============================================================================

# --- Backend Configuration ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<supabase-project-ref>.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# Firebase Admin Configuration
FIREBASE_CONFIG_PATH=firebase-adminsdk.json
FIREBASE_PROJECT_ID=quickbite-campus
# Set to true when firebase-adminsdk.json is present
FIREBASE_AUTH_ENABLED=false

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Supabase Storage Integration
SUPABASE_URL=https://<supabase-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=QuickBite

# --- Frontend & Electron Configuration ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=quickbite-campus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quickbite-campus
VITE_FIREBASE_STORAGE_BUCKET=quickbite-campus.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
