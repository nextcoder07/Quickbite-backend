# ==============================================================================
# QuickBite Campus Food Marketplace - Environment Configuration Template
# Copy this file to .env or configure respective frontend/backend environments.
# NEVER commit real credentials to source control.
# ==============================================================================

# --- Backend Configuration ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Admin Security Key (Required for instant Admin signup & suspending Admins)
ADMIN_SIGNUP_KEY=your_admin_security_key

# Strictly choose active PostgreSQL database: "supabase" or "local" (NO fallback)
DB_TARGET=supabase
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# Supabase Hosted PostgreSQL (used when DB_TARGET=supabase)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<supabase-project-ref>
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Local PostgreSQL (used when DB_TARGET=local)
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/quickbite
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=your_local_postgres_password

# Firebase Admin Configuration
FIREBASE_CONFIG_PATH=firebase-adminsdk.json
FIREBASE_PROJECT_ID=quick-bite-firebase
FIREBASE_AUTH_ENABLED=true

# Optional Outbound HTTP/HTTPS Proxy (set PROXY_ENABLED=true only behind a proxy)
PROXY_ENABLED=false
PROXY_HOST=172.31.2.4
PROXY_PORT=8080
PROXY_NON_PROXY_HOSTS=localhost|127.0.0.1
PREFER_IPV4_STACK=true

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Supabase Storage Integration
SUPABASE_URL=https://<supabase-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=QuickBite

# --- Frontend & Electron Configuration ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=quickbite-campus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quickbite-campus
VITE_FIREBASE_STORAGE_BUCKET=quickbite-campus.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
