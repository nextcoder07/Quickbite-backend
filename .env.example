# ==============================================================================
# QuickBite Campus Food Marketplace — Full-Stack Environment Template (.env.example)
# ==============================================================================
# This template documents all variables across both the Spring Boot backend
# and the React/Electron frontend.
#
# QUICK START:
# - Backend config lives in "backend/.env"
# - Frontend config lives in "frontend/.env"
# ==============================================================================

# ==============================================================================
# PART 1: BACKEND ENVIRONMENT (backend/.env)
# ==============================================================================

# Server & Profile Configuration
PORT=8080
# Set to "dev" locally (loads application-dev.yml) or "prod" on Render (loads application-prod.yml)
SPRING_PROFILES_ACTIVE=dev

# CORS origins permitted to call REST APIs (React dev server & Electron shell)
CORS_ALLOWED_ORIGIN_PATTERNS=*

# Secret key required for instant Administrator self-verification and suspension actions
ADMIN_SIGNUP_KEY=your_admin_security_key

# Active Database Switch: "supabase" OR "local" (NO silent fallback)
DB_TARGET=supabase
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_FLYWAY_ENABLED=true

# Target A: Supabase Cloud PostgreSQL (used when DB_TARGET=supabase)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<supabase-project-ref>
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Target B: Local PostgreSQL (used when DB_TARGET=local)
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/quickbite
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=your_local_postgres_password

# Firebase Admin SDK (Token verification & custom claims)
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=quick-bite-firebase
FIREBASE_CONFIG_PATH=firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Supabase Storage Integration (Bucket for shop banners & food pictures)
SUPABASE_URL=https://<supabase-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=QuickBite

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Optional Outbound HTTP/HTTPS Proxy (set PROXY_ENABLED=true only behind a corporate/campus proxy)
PROXY_ENABLED=false
PROXY_HOST=172.31.2.4
PROXY_PORT=8080
PROXY_NON_PROXY_HOSTS=localhost|127.0.0.1
PREFER_IPV4_STACK=true

# ==============================================================================
# PART 2: FRONTEND ENVIRONMENT (frontend/.env)
# ==============================================================================

# Backend API Target (Local or Cloud)
VITE_API_BASE_URL=http://localhost:8080/api/v1
# VITE_API_BASE_URL=https://<your-render-backend>.onrender.com/api/v1

# Firebase Client Web SDK Configuration
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
